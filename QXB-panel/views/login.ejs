<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QXB - Secure Access</title>
    <link rel="stylesheet" href="/css/cyber.css">
    <style>
        body {
            justify-content: center;
            align-items: center;
            height: 100vh;
            padding: 20px;
        }

        .login-card {
            width: 100%;
            max-width: 400px;
            padding: 40px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        /* Decorative glowing dots */
        .login-card::before {
            content: '';
            position: absolute;
            top: -20%;
            left: -20%;
            width: 140px;
            height: 140px;
            background: radial-gradient(circle, var(--accent-cyan-glow) 0%, transparent 70%);
            z-index: 0;
            pointer-events: none;
        }

        .login-card::after {
            content: '';
            position: absolute;
            bottom: -20%;
            right: -20%;
            width: 140px;
            height: 140px;
            background: radial-gradient(circle, var(--accent-purple-glow) 0%, transparent 70%);
            z-index: 0;
            pointer-events: none;
        }

        .branding {
            position: relative;
            z-index: 1;
            margin-bottom: 32px;
        }

        .logo-img {
            max-width: 90px;
            filter: drop-shadow(0 0 15px var(--accent-cyan-glow));
            animation: pulse-glow 3s infinite ease-in-out;
            margin-bottom: 16px;
        }

        @keyframes pulse-glow {
            0%, 100% {
                transform: scale(1);
                filter: drop-shadow(0 0 12px var(--accent-cyan-glow));
            }
            50% {
                transform: scale(1.05);
                filter: drop-shadow(0 0 25px rgba(0, 242, 254, 0.6));
            }
        }

        .title {
            font-size: 2rem;
            background: linear-gradient(135deg, var(--accent-cyan) 0%, var(--accent-purple) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 6px;
        }

        .subtitle {
            font-size: 0.9rem;
            color: var(--text-secondary);
        }

        .alert-error {
            background: rgba(255, 0, 85, 0.1);
            border: 1px solid var(--accent-danger);
            color: var(--accent-danger);
            padding: 12px;
            border-radius: 10px;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 24px;
            text-shadow: 0 0 10px rgba(255, 0, 85, 0.2);
            position: relative;
            z-index: 1;
        }

        form {
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .input-group {
            text-align: left;
        }

        .btn-submit {
            margin-top: 10px;
            padding: 14px;
            font-size: 0.95rem;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }
    </style>
</head>

<body>
    <div class="login-card glass-panel">
        <div class="branding">
            <img src="https://fuchsia-quickest-kite-522.mypinata.cloud/ipfs/bafkreifxytn5dxnfaj2thdcpj3n7ltoufvhipekdpvijspsc6lg66m5e3m"
                alt="QXB Logo" class="logo-img">
            <h1 class="title">QXB</h1>
            <p class="subtitle">Operations console authentication</p>
        </div>

        <% if (messages.error) { %>
            <div class="alert-error">
                <%= messages.error %>
            </div>
        <% } %>

        <form action="/login" method="POST">
            <input type="hidden" name="name" value="qxb">
            <div class="input-group">
                <label class="form-label" for="password">Password</label>
                <input type="password" id="password" name="password" class="form-input" placeholder="Enter dashboard password" required autofocus>
            </div>
            <button type="submit" class="btn btn-cyan btn-submit">Sign In</button>
        </form>
    </div>
</body>

</html>